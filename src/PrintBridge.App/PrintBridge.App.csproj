<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PrintBridge.App</RootNamespace>
    <AssemblyName>PrintBridge.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Single source of truth for the app version. Bump this for each release;
         the installer reads it from the built exe, and the in-app updater compares
         it against the latest GitHub release tag. -->
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintBridge.Protocol\PrintBridge.Protocol.csproj" />
    <ProjectReference Include="..\PrintBridge.Spooler\PrintBridge.Spooler.csproj" />
  </ItemGroup>

</Project>
